    "ckeditor5": "^48.1.1",
    "dompurify": "^3.4.7",
    "libphonenumber-js": "^1.13.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router": "^7.14.2",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
