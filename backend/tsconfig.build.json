{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "..",
    "outDir": "dist",
    "sourceMap": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/localAttendance.ts", "src/localReview.ts", "src/dev.ts"]
}
