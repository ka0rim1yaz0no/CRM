{
  "name": "crm-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:attendance": "tsx src/localAttendance.ts",
    "dev": "tsx watch src/dev.ts",
    "start": "npm run build:production && node dist/server.js",
    "start:compiled": "node dist/server.js",
    "test:production": "node scripts/production-smoke.mjs",
    "build:production": "node scripts/prepare-build.mjs && tsc -p tsconfig.build.json && node scripts/resolve-built-imports.mjs",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:survey": "tsx --test src/services/hempSurveyService.test.ts",
    "build": "npm run typecheck",
    "test:tomtom-relevance": "tsx --test src/services/tomTomRelevance.test.ts src/services/tomTomSearchService.test.ts",
    "test:calls": "tsx --test src/config/callProvider.test.ts src/controllers/attendanceController.test.ts src/services/callDashboardService.test.ts src/services/callBridgeSession.test.ts src/services/leadAutoCallEligibility.test.ts",
    "reconcile:attendance": "tsx src/scripts/reconcileAttendance.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^9.0.1",
    "socket.io": "^4.8.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/ws": "^8.18.1",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
